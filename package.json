{
  "name": "app-chat-third",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "scripts": {
    "start": "expo start --dev-client -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "bundle:web": "npx expo export --platform web",
    "serve:web": "npx serve dist",
    "prebuild:clean": "npx expo prebuild --clean",
    "prebuild:ios": "npx expo prebuild --clean --platform ios",
    "prebuild:android": "npx expo prebuild --clean --platform android",
    "compile": "tsc --noEmit -p . --pretty",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "depcruise": "depcruise app --config .dependency-cruiser.js",
    "depcruise:graph": "depcruise app --include-only \"^app\" --config .dependency-cruiser.js --output-type dot > app-dependency-graph.dot && dot -T svg app-dependency-graph.dot -o app-dependency-graph.svg && dot -T png app-dependency-graph.dot -o app-dependency-graph.png && rm app-dependency-graph.dot",
    "align-deps": "npx expo install --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=com.fanos .maestro/flows",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "build:ios:sim": "eas build --profile development --platform ios --local",
    "build:ios:device": "eas build --profile development:device --platform ios --local",
    "build:ios:preview": "eas build --profile preview --platform ios --local",
    "build:ios:prod": "eas build --profile production --platform ios --local",
    "build:android:sim": "eas build --profile development --platform android --local",
    "build:android:device": "eas build --profile development:device --platform android --local",
    "build:android:preview": "eas build --profile preview --platform android --local",
    "build:android:prod": "eas build --profile production --platform android --local",
    "postinstall": "bash scripts/link-local-packages.sh",
    "generate:splash": "yarn react-native-bootsplash generate ./assets/logo/logo.png -platforms=android,ios --background=#000 --logo-width=200 --assets-output=assets/bootsplash --flavor=main",
    "generate:icomoon": "node scripts/generate-icomoon.js",
    "clean:all": "printf \"Cleaning project...\\n\" && rm -rf node_modules/ yarn.lock package-lock.json pnpm-lock.yaml .pnp.* || true && find . -type d -name 'node_modules' -prune -exec rm -rf '{}' + 2>/dev/null || true && rm -rf ios/Pods ios/Podfile.lock ios/Pods/Manifest.lock ios/Build || true && rm -rf android/.gradle android/build android/app/build android/app/.cxx || true && yarn cache clean --all 2>/dev/null || npm cache clean --force 2>/dev/null || true && watchman watch-del-all 2>/dev/null || true && rm -rf /tmp/metro-* 2>/dev/null || true && printf \"Clean finished. You can now reinstall dependencies.\\n\""
  },
  "dependencies": {
    "@communi/chat-react-native": "^3.1.13",
    "@communi/keyboard-area-react-native": "^2.0.3",
    "@communi/mqtt-client-interface-typescript": "^2.0.1",
    "@communi/mqtt-client-react-native": "^2.0.5",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^8.5.1",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-documents/picker": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@realm/react": "^0.20.0",
    "axios": "^1.14.0",
    "dayjs": "^1.11.20",
    "expo": "~55.0.0",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.9",
    "expo-constants": "~17.0.3",
    "expo-font": "~55.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~55.0.10",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.16",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.0",
    "expo-system-ui": "~55.0.9",
    "expo-web-browser": "~55.0.16",
    "lodash": "^4.18.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-date-picker": "^5.0.13",
    "react-native-worklets": "0.7.4",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-share": "^12.2.6",
    "react-native-svg": "15.15.3",
    "react-native-video": "^6.19.1",
    "react-native-web": "~0.21.0",
    "realm": "^20.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^18.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "resolutions": {
    "react-native": "0.83.4",
    "@types/react": "~19.2.10",
    "react-native-reanimated": "4.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "reanimated": {
    "staticFeatureFlags": {
      "ENABLE_SHARED_ELEMENT_TRANSITIONS": true
    }
  },
  "private": true
}