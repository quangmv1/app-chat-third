{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@communi/chat-ui-react-native": [
        "./Library/chat-ui-react-native/src/index.ts"
      ],
      "@communi/chat-ui-react-native/*": [
        "./Library/chat-ui-react-native/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
