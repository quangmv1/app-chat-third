{
  "name": "@communi/chat-ui-react-native",
  "version": "2.0.1",
  "description": "PiScale Chat UI React Native",
  "homepage": "https://github.com/piscale/chat-ui-react-native#readme",
  "bugs": {
    "url": "https://github.com/piscale/chat-ui-react-native/issues"
  },
  "repository": "https://github.com/piscale/chat-ui-react-native",
  "license": "MIT",
  "author": "PiScale Developer <piscale_dev@piscale.com> (https://piscale.com)",
  "main": "src/index.ts",
  "scripts": {
    "bootstrap": "yarn example && yarn install",
    "npm:publish": "gulp build && cd dist && npm publish --access public && cd .. && rm -rf dist",
    "build": "gulp build && npm pack ./dist && rm -rf dist",
    "build:dev": "gulp build-dev && npm pack ./dist && rm -rf dist",
    "lint": "eslint --ext .ts,.tsx src",
    "prepack": "bob build",
    "release": "release-it",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "upgrade_dependencies": "yarn upgrade-interactive --latest"
  },
  "eslintIgnore": [
    "node_modules/"
  ],
  "jest": {
    "preset": "react-native"
  },
  "resolutions": {},
  "dependencies": {
    "@communi/chat-api-client-typescript": "^2.9.11",
    "@gorhom/bottom-sheet": "^4.4.8",
    "i18next": "^23.4.6",
    "lodash.debounce": "^4.0.8",
    "moment": "^2.29.4",
    "react-native-dialog": "^9.3.0",
    "react-native-image-pan-zoom": "^2.1.12",
    "react-native-logs": "^5.0.1",
    "react-native-modal": "^13.0.1",
    "react-native-progress": "^5.0.1",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-toast-message": "^2.1.6",
    "react-native-uuid": "^2.0.1",
    "rn-emoji-keyboard": "^1.4.0",
    "simple-markdown": "^0.7.3",
    "react-native-image-picker": "^7.2.3"
  },
  "devDependencies": {},
  "peerDependencies": {
    "@communi/chat-api-client-typescript": "*",
    "@communi/mqtt-client-interface-typescript": "*",
    "@react-native-community/netinfo": "*",
    "@realm/react": "*",
    "moment": "*",
    "react": "*",
    "react-moment": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-svg": "*",
    "realm": "*"
  },
  "packageManager": "^yarn@1.22.15",
  "engines": {
    "node": ">= 16.0.0"
  }
}